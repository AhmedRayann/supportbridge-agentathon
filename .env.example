# Milestone 1A needs no credentials.
# Next.js server configuration only. Copy this line to frontend/.env.local
# for local development (also the default). For two Vercel projects, use the
# backend's HTTPS origin with no trailing path. Leave unset for Vercel Services.
BACKEND_URL=http://127.0.0.1:8000

# Future backend model configuration; no model integration exists yet.
# This file is a reference: tools read process environment, not .env files.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
# Milestone 2C backend PostgreSQL. Never expose this through NEXT_PUBLIC_*.
# Use the provider transaction-pooler URL with sslmode=require (or verify-full).
DATABASE_URL=
# Local frontend origin; use the exact HTTPS production origin on Vercel.
PUBLIC_APP_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
SESSION_NEW_INVESTIGATIONS_PER_DAY=2
MAX_GLOBAL_ACTIVE_RUNS=4
# Execution slots exclude awaiting_review; pending runs still consume capacity.
# Configurable from 1 through 100; tune after measuring real agent workloads.
MAX_GLOBAL_NEW_RUNS_PER_DAY=20
STAGE_LEASE_SECONDS=60
# Test-only disposable PostgreSQL database, never the production database.
TEST_DATABASE_URL=

# Milestone 2B backend-only investigation tools. Optional token for public reads;
# prefer read-only public Contents access. Never use NEXT_PUBLIC_* for credentials.
GITHUB_TOKEN=
# Blank GitHub values resolve from the approved release manifest. If set, all
# must match it exactly. Release refs must be its full commit SHAs, not tag names.
DEMO_GITHUB_OWNER=
DEMO_GITHUB_REPO=
DEMO_SOURCE_PREFIX=
SANDBOX_API_BASE_URL=http://127.0.0.1:8000
DEMO_RELEASE_V1_0_REF=
DEMO_RELEASE_V1_1_REF=

# For production experiments explicitly set the backend process variable to:
# SANDBOX_API_BASE_URL=https://supportbridge-agentathon.vercel.app
# Only that HTTPS origin or explicit localhost HTTP is accepted. No fallback.

MAX_MODEL_CALLS_PER_RUN=10
# Host-only model ceiling: 1 through 20. Existing runs retain their captured limit.
MAX_EXPERIMENTS_PER_RUN=8
# 2C recording context binds durable reservations; the standalone 2B HTTP tool
# remains for manual use only. Future model registry must use the scoped context.
# Keep false in the public demo until real model integration is reviewed.
AI_RUNS_ENABLED=false
